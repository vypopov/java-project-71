.PHONY: build install clean run check spotlessCheck spotlessApply jacocoTest test


build:
	./gradlew build

install:
	./gradlew installDist

clean:
	./gradlew clean

run:
	./gradlew run

check:
	./gradlew check

spotlessCheck:
	./gradlew spotlessCheck

spotlessApply:
	./gradlew spotlessApply

jacocoTest:
	./gradlew jacocoTestCoverageVerification

test:
	./gradlew test